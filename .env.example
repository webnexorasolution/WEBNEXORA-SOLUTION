# ==========================================
# WEBNEXORA SOLUTION - ENVIRONMENT TEMPLATE
# Copy this file to .env and customize your values
# ==========================================

# App & Site Info
VITE_APP_ENV=development
VITE_SITE_NAME="Webnexora Solution"
VITE_SITE_TAGLINE="Precision Engineering · Clean UX · Measurable Growth"
VITE_SITE_URL="https://webnexorasolution.com"

# Contact & Direct Lines
VITE_CONTACT_EMAIL="hello@webnexora.com"
VITE_CONTACT_PHONE="+91 XXXXX XXXXX"
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_OFFICE_HOURS="9:00 AM – 9:00 PM IST (Mon - Sat)"
VITE_OFFICE_LOCATION="Mumbai, Maharashtra, India"

# Social Links
VITE_SOCIAL_FACEBOOK="https://facebook.com"
VITE_SOCIAL_INSTAGRAM="https://instagram.com"
VITE_SOCIAL_LINKEDIN="https://linkedin.com"
VITE_SOCIAL_YOUTUBE="https://youtube.com"
VITE_SOCIAL_GITHUB="https://github.com/webnexorasolution"

# ==========================================
# DATABASE & SUPABASE CONFIGURATION
# ==========================================
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>"
DB_HOST="aws-0-eu-west-2.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER="postgres.<project-ref>"
DB_PASSWORD="<password>"

# Supabase API Endpoint
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-key>"
